{
  "name": "glasgowtheatre-com",
  "version": "1.0.0",
  "description": "**glasgowtheatre.com** \u2014 What's on in Glasgow's theatre scene.",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "refresh": "node scripts/scrape-events.js && node scripts/read-tickets.js && node scripts/tag-events.js && node scripts/cache-images.js && node scripts/read-artwork.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "preview": "python3 -m http.server 4173 --directory dist",
    "tag": "node scripts/tag-events.js",
    "build:cloudflare": "bash scripts/cloudflare-build.sh",
    "report": "node scripts/report-new.js",
    "deploy:worker": "bash scripts/deploy-worker.sh",
    "setup:cloudflare": "bash scripts/setup-cloudflare.sh",
    "tickets": "node scripts/read-tickets.js",
    "artwork": "node scripts/read-artwork.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shstkvch/glasgowtheatre-com.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/shstkvch/glasgowtheatre-com/issues"
  },
  "homepage": "https://github.com/shstkvch/glasgowtheatre-com#readme",
  "dependencies": {
    "cheerio": "^1.2.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "sharp": "^0.35.4"
  }
}
