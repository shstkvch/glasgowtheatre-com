# Which model answers, and who pays for it.
#
# DeepSeek is called directly first; OpenRouter is the fallback if DeepSeek has
# no key, fails, rate-limits or answers nonsense. Set either or both. Without
# both, tagging falls back to keyword matching and the build still works.
DEEPSEEK_API_KEY=

# Optional: DeepSeek's model id. Defaults to deepseek-flash.
# DEEPSEEK_MODEL=deepseek-flash

OPENROUTER_API_KEY=

# Optional: any OpenRouter model id. Defaults to deepseek/deepseek-v4-flash.
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Artwork stays on the vision model it was tested against, whichever scraping
# key is in use. Get a key at https://openrouter.ai/keys
# ARTWORK_MODEL=google/gemini-2.5-flash-lite
